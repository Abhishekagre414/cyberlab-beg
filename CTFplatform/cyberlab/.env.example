# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is already listed in .gitignore -- never commit real secrets.

# Flask session-signing key. Required for anything beyond quick, throwaway
# local testing -- without it, app.py falls back to an obviously-labeled
# insecure development key and logs a warning on startup.
# Generate a real one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-for-your-local-environment

# "1" to enable Flask debug mode (auto-reload + interactive debugger).
# Leave at 0 unless you are actively developing this project -- debug
# mode is not safe to leave on, even locally, since it can expose a
# code-execution console in the browser on unhandled errors.
FLASK_DEBUG=0

# Interface to bind to when running app.py directly (not via Docker).
# Leave at 127.0.0.1 -- this app is intentionally vulnerable and must
# never be reachable from outside your own machine.
HOST=127.0.0.1
