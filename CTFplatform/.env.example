# ---- REQUIRED --------------------------------------------------------------
# Long random string. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the built-in `admin` account (created on first start).
# If left empty, a random one is generated and printed once in the logs.
ADMIN_PASSWORD=

# ---- DATABASE --------------------------------------------------------------
# Vercel / any serverless host: a hosted Postgres URL (Neon, Supabase, Vercel Postgres).
# Docker compose builds this for you from the POSTGRES_* values below.
DATABASE_URL=

POSTGRES_USER=ctfuser
POSTGRES_PASSWORD=
POSTGRES_DB=ctfdb

# ---- OPTIONAL ---------------------------------------------------------------
# Redis for shared sessions + rate limiting (compose sets this automatically).
# Leave empty on Vercel unless you use a hosted Redis (e.g. Upstash rediss://...).
# REQUIRED for Docker/VPS production (compose sets it for you): the app refuses
# to start in production with per-process rate limits. Set
# ALLOW_MEMORY_RATELIMIT=true only if you knowingly run a single worker.
REDIS_URL=

# Only when TLS is terminated by YOUR nginx/proxy (never needed on Vercel).
FORCE_HTTPS=false

# AI resume analyser (falls back to a mock answer when empty)
GEMINI_API_KEY=
SENTRY_DSN=

# Create a demo learner "Alex" on first start (local demos only)
SEED_DEMO_USER=false

# ---- LAB ENGINE ---------------------------------------------------------------
# DEV ONLY. Lets the platform run uploaded lab code directly on this machine
# when Docker is unavailable. NEVER enable on a server: it executes untrusted
# code with the web app's privileges.
ALLOW_NATIVE_LABS=false

# Set automatically by docker-compose (socket proxy). Leave empty for a local
# Docker daemon.
DOCKER_HOST=

# ---- WEB SERVER / TLS (deploy.sh sets these for you) -------------------------
# NGINX_MODE=http (plain HTTP) or https (needs ssl/fullchain.pem + ssl/privkey.pem
# from scripts/get_cert.sh). SERVER_NAME is your domain, or _ for any host.
NGINX_MODE=http
SERVER_NAME=_

# ---- WHERE LEARNERS REACH LABS ------------------------------------------------
# Default: loopback only (learners on the server itself / via SSH tunnel).
# Remote learners: LAB_BIND_ADDR=0.0.0.0 and LAB_PUBLIC_HOST=<server name or IP>,
# then firewall TCP 10000-20000 to your learners only (labs are vulnerable apps).
LAB_BIND_ADDR=127.0.0.1
LAB_PUBLIC_HOST=127.0.0.1
